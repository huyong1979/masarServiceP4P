NOTUSEDDIRS/
*.db
# Keep a reference database for users; local/production masar.db stays ignored.
!masar_example.db
# Local client backups from the C++ -> p4p migration
*.cpp-backup
__pycache__/
*.pyc
python/**/masar.log

# EPICS cpp build outputs (should not be tracked)
cpp/bin/
cpp/lib/
cpp/include/pv/
cpp/configure/O.*/
cpp/src/**/O.*/

# Local, machine-specific overrides (not tracked)
cpp/configure/RELEASE.local
pixi.lock

# legacy pre-flattening paths (kept for safety)
masarService/python/**/masar.log
masarService/cpp/bin/
masarService/cpp/lib/
masarService/cpp/include/pv/
masarService/cpp/configure/O.*/
masarService/cpp/src/**/O.*/
